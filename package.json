    "typescript": "5.9.3",
    "undici": "6.21.3",
    "webpack": "5.106.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource/roboto": "5.2.10",
    "@mui/icons-material": "6.4.4",
    "@mui/material": "6.4.4",
    "@reduxjs/toolkit": "2.11.2",
    "axios": "1.16.0",
    "hsp-fo-workspace": "1.9.73",
    "i18next": "25.7.4",
    "lodash": "4.18.1",
    "material-ui-popup-state": "5.3.7",
    "react": "18.3.1",
    "react-beforeunload": "2.7.0",
    "react-dom": "18.3.1",
    "react-draggable": "4.5.0",
    "react-i18next": "15.7.3",
    "react-redux": "9.2.0",
    "react-scroll": "1.9.3",
    "slate": "0.124.1",
    "slate-history": "0.113.1",
